{
  "name": "aws-blocks-mcp",
  "version": "0.1.1",
  "type": "module",
  "description": "MCP server for AWS Blocks projects: lets an AI agent discover your Building Blocks, read local and deployed data, and call your API. Read-only by default.",
  "keywords": [
    "aws-blocks",
    "aws",
    "mcp",
    "model-context-protocol",
    "devtools"
  ],
  "license": "MIT",
  "author": "Salih Guler",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salihgueler/aws-blocks-community-devtools.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/salihgueler/aws-blocks-community-devtools/tree/main/packages/mcp#readme",
  "bugs": "https://github.com/salihgueler/aws-blocks-community-devtools/issues",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "aws-blocks-mcp": "bin/aws-blocks-mcp.mjs"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "start": "tsx src/mcp-entry.mts",
    "verify": "tsx src/verify-mcp.mts",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-cloudformation": "3.1161.0",
    "@aws-sdk/client-cognito-identity-provider": "3.1161.0",
    "@aws-sdk/client-dynamodb": "3.1161.0",
    "@aws-sdk/client-sts": "3.1161.0",
    "@aws-sdk/lib-dynamodb": "3.1161.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "ts-morph": "28.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@aws-blocks-devtools/core": "*",
    "tsup": "9.0.0"
  }
}
